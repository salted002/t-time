NODE_ENV=development
PORT=4000

DB_HOST=
DB_PORT=5432
DB_NAME=ttime_db
DB_USER=ttimeadmin
DB_PASSWORD=

DIALECT=postgres
DB_SSL=true

# Storage Configuration
# STORAGE_TYPE: 'local' or 'azure'
STORAGE_TYPE=azure
LOCAL_STORAGE_PATH=

# Azure Blob Storage (required if STORAGE_TYPE=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

JWT_SECRET=
JWT_ADMIN_SECRET=

COOLSMS_API_KEY=
COOLSMS_API_SECRET=

FRONTEND_BASE_URL=http://localhost:5173
