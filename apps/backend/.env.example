DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

DIALECT=postgres
DB_SSL=true

# Storage Configuration
# STORAGE_TYPE: 'local' or 'azure'
STORAGE_TYPE=
LOCAL_STORAGE_PATH=

# Azure Blob Storage (required if STORAGE_TYPE=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# 인증
JWT_SECRET=
JWT_EXPIRES_IN=1d
SALT_ROUNDS=
JWT_ADMIN_SECRET=

# COOLSMS 연동 기능
COOLSMS_API_KEY=
COOLSMS_API_SECRET=

# OPENAI 연동 기능 — 엔드포인트는 .com 뒷부분을 삭제 (/openai/v1 삭제)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# 프론트 주소
FRONTEND_BASE_URL=http://localhost:5173
